/*
 Works around an issue on macOS where the launcher dialog was entirely transparent.
*/
QStackedWidget#sw_SwiftLauncher {
  background-color: #141414;
}

/* Start page launch buttons */
#pg_Start QToolButton {
  background-color: #1f1f1f;
  border: 1px solid #424242;
  border-radius: 8px;
  color: #d9d9d9;
  padding: 8px;
}

#pg_Start QToolButton:hover {
  background-color: #111a2c;
  border: 1px solid #3c89e8;
  border-radius: 8px;
  color: #69b1ff;
  min-width: 30px;
  min-height: 30px;
}

#pg_Start QToolButton:pressed {
  background-color: #15325b;
  border-color: #1668dc;
}

#pg_start QToolTip {
  color: #d9d9d9;
  background-color: #1f1f1f;
  border: 1px solid #424242;
}
