 */

/*
 Ant Design 5 dark theme adapted for Qt Widgets.
 The palette mirrors web-frontend's ConfigProvider darkAlgorithm and compact
 desktop component metrics:
   bg-base:        #141414  (page/window)
   bg-container:   #1f1f1f  (cards, dialogs, menus)
   bg-elevated:    #262626  (hovered/elevated controls)
   bg-selected:    #111a2c  (selected rows and tabs)
   border-default: #424242
   border-split:   #303030
   primary:        #1668dc  (dark algorithm result from #1677ff seed)
   primary-hover:  #3c89e8
   primary-active: #1554ad
   text-primary:   #d9d9d9
   text-secondary: #a6a6a6
   text-disabled:  #595959
   success:        #49aa19
   warning:        #d89614
   error:          #dc4446

Used dynamic properties:
  framelessMainWindow (infobar.qss, here)
*/

/* ============================================================
   BASE WIDGET
   ============================================================ */

QFrame {
  border-style: solid;
  border-color: transparent;
  border-width: 1px;
}

QCheckBox {
  border: 0px;
  background: transparent;
  spacing: 6px;
}

QCheckBox::indicator {
  color: #d9d9d9;
  border: 1px solid #424242;
  background-color: #141414;
  width: 14px;
  height: 14px;
  border-radius: 4px;
}

QCheckBox::indicator:hover {
  border-color: #3c89e8;
}

QCheckBox::indicator:checked {
  background-color: #1668dc;
  border-color: #1668dc;
  image: url(:/ant-design/icons/ant-design/check.svg);
}

QCheckBox::indicator:indeterminate {
  background-color: #1668dc;
  border-color: #1668dc;
  image: url(:/ant-design/icons/ant-design/question.svg);
}

QCheckBox[readOnly="true"] {
  color: #8c8c8c;
}

QCheckBox[readOnly="true"]::indicator {
  background-color: #262626;
  border-color: #303030;
}

/* ============================================================
   MAIN WINDOW / DIALOG
   ============================================================ */

QMainWindow {
  background-color: #141414;
}

QMainWindow::separator {
  background: transparent;
  width: 0px;
  height: 0px;
}

QMainWindow::separator:hover {
  background: transparent;
}

QDialog {
  background-color: #141414;
}

QDialog::separator {
  background: transparent;
  width: 0px;
  height: 0px;
}

QDialog::separator:hover {
  background: transparent;
}

QFileDialog #sidebar {
  background: #1f1f1f;
}

QFileDialog QToolButton {
  background: inherit;
}

QColorDialog {
  background-color: #141414;
}

/* ============================================================
   DOCK WIDGET / INFO AREA
   ============================================================ */

swift--gui--CDockWidgetInfoArea {
  background-color: #1668dc;
}

swift--gui--CDockWidgetInfoArea > QWidget[dockwidget="outerwidget"] {
  background-color: #1f1f1f;
}

swift--gui--CDockWidgetInfoArea[framelessDockWidget="true"] > QWidget > QFrame[dockwidget="innerwidget"] {
  margin: 0px;
  padding: 3px;
  border: 1px solid #1668dc;
  border-radius: 6px;
}

swift--gui--CDockWidgetInfoArea[framelessDockWidget="false"] > QWidget > QFrame[dockwidget="innerwidget"] {
  /* void */
}

swift--gui--CInfoArea {
  background-color: #1f1f1f;
}

swift--gui--COverlayMessages {
  background-color: rgba(20, 20, 20, 220);
  border: 1px solid #424242;
  border-radius: 8px;
  padding: 8px;
}

swift--gui--CDropSite {
  color: #a6a6a6;
  border: 1px dashed #424242;
  border-radius: 6px;
  min-height: 18px;
  max-height: 18px;
  margin: 2px;
  padding: 2px;
}

swift--gui--Editors--CValidationIndicator {
  background-color: #1f1f1f;
}

swift--gui--CPluginDetailsWindow,
swift--gui--CPluginConfigWindow {
  background-color: #141414;
}

swift--gui--Components--CDBusServerAddressSelector::disabled {
  background-color: rgba(48, 48, 48, 128);
}

swift--gui--Components--CSimulatorSelector::disabled {
  background-color: rgba(48, 48, 48, 128);
}

swift--gui--Components--CAircraftModelSetValidationDialog,
swift--gui--Components--CCoreSettingsDialog,
swift--gui--Views--CAircraftModelValidationDialog,
swift--gui--Views--CAircraftModelStatisticsDialog,
swift--gui--Components--CSettingsFontDialog,
swift--gui--Components--CAirportDialog,
swift--gui--Components--CTextEditDialog,
swift--gui--Components--CSetupLoadingDialog,
swift--gui--Components--CDownloadComponent,
swift--gui--Components--CDownloadDialog,
swift--gui--Components--CUpdateInfoDialog,
swift--gui--Components--CRawFsdMessagesComponent,
swift--gui--Components--CRawFsdMessagesDialog,
swift--gui--Components--CDbOwnModelsDialog,
swift--gui--Components--CDbOwnModelSetDialog,
swift--gui--Components--CFirstModelSetComponent,
swift--gui--Components--CDbAircraftIcaoComponent,
swift--gui--Components--CDbLiveryComponent,
swift--gui--Components--CDbDistributorComponent,
swift--gui--Components--CLegalInfoComponent,
swift--gui--Components--CStringListDialog
{
  background-color: #1f1f1f;
}

swift--gui--Components--CCockpitComComponent {
  min-height: 7em;
}

/* ============================================================
   BUTTONS
   ============================================================ */

QToolButton {
  background-color: transparent;
  border: 1px solid #424242;
  border-radius: 6px;
  padding: 3px 7px;
  color: #d9d9d9;
  min-height: 20px;
}

QToolButton:hover {
  background-color: #262626;
  border-color: #3c89e8;
}

QToolButton:pressed {
  background-color: #111a2c;
  border-color: #1554ad;
}

QPushButton {
  background-color: transparent;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 3px 12px;
  margin-right: 4px;
  min-width: 32px;
  min-height: 22px;
}

QPushButton:hover {
  background-color: #262626;
  border-color: #3c89e8;
  color: #69b1ff;
}

QPushButton:pressed {
  background-color: #111a2c;
  border-color: #1554ad;
}

QPushButton:checked {
  background-color: #111a2c;
  border-color: #1668dc;
  color: #69b1ff;
}

QPushButton:focus {
  border-color: #424242;
  outline: none;
}

QPushButton:default,
QPushButton[buttonRole="primary"],
#pb_Ok,
#pb_Connect {
  background-color: #1668dc;
  border-color: #1668dc;
  color: #ffffff;
}

QPushButton:default:hover,
QPushButton[buttonRole="primary"]:hover,
#pb_Ok:hover,
#pb_Connect:hover {
  background-color: #3c89e8;
  border-color: #3c89e8;
  color: #ffffff;
}

QPushButton:default:pressed,
QPushButton[buttonRole="primary"]:pressed,
#pb_Ok:pressed,
#pb_Connect:pressed {
  background-color: #1554ad;
  border-color: #1554ad;
}

QPushButton[buttonRole="danger"] {
  background-color: #dc4446;
  border-color: #dc4446;
  color: #ffffff;
}

QPushButton:disabled {
  background-color: #262626;
  border: 1px solid #303030;
  color: #595959;
  margin-right: 4px;
  qproperty-textElideMode: ElideMiddle;
}

QPushButton[blinkOn="true"] {
  background-color: #d89614;
  border-color: #d89614;
  color: #141414;
}

/* ============================================================
   PROGRESS BAR
   ============================================================ */

QProgressBar {
  border: 1px solid #424242;
  border-radius: 6px;
  background-color: #262626;
  text-align: center;
  color: #d9d9d9;
  padding: 0px;
  height: 16px;
}

QProgressBar::chunk {
  background-color: #1668dc;
  border-radius: 5px;
  margin: 1px;
}

/* ============================================================
   TABS
   ============================================================ */

QTabWidget::pane {
  border: 1px solid #303030;
  background-color: #141414;
}

QTabWidget::tab-bar {
  left: 0px;
}

QTabBar::tab {
  background-color: transparent;
  border: none;
  border-bottom: none;
  color: #a6a6a6;
  min-width: 30px;
  padding: 6px 10px;
  margin-right: 2px;
}

QTabBar::tab:selected {
  background-color: transparent;
  color: #ffffff;
  border-bottom: 2px solid #1668dc;
}

QTabBar::tab:hover:!selected {
  background-color: #303030;
  color: #d9d9d9;
  border-bottom: 2px solid #15325b;
}

QTabBar::tear {
  image: url(:/own/icons/own/transparent1px.png);
  max-width: 1px;
}

QTabBar QToolButton {
  background-color: transparent;
  border: none;
  color: #d9d9d9;
}

QTabBar QToolButton:hover {
  background-color: #303030;
}

/* supervisor message tab highlight */
QTabBar::tab[supervisormsg=true] {
  background-color: #2c1618;
  border-color: #dc4446;
  color: #dc4446;
}

QTabBar QToolButton[supervisormsg=true] {
  background-color: #2c1618;
}

/* ============================================================
   SPLITTER
   ============================================================ */

QSplitter {
  margin: 0px;
  border: 0px;
  padding: 0px;
}

QSplitter::handle {
  background-color: #303030;
  margin: 0px;
}

QSplitter::handle:horizontal {
  width: 3px;
}

QSplitter::handle:vertical {
  height: 3px;
}

QSplitter::handle:hover {
  background-color: #1668dc;
}

QSplitter::handle:pressed {
  background-color: #1668dc;
}

/* ============================================================
   LABEL
   ============================================================ */

QLabel {
  background: transparent;
}

/* ============================================================
   LINE EDIT / TEXT EDIT
   ============================================================ */

QLineEdit,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 3px 7px;
  min-height: 20px;
  selection-background-color: #111a2c;
}

QLineEdit:hover,
QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover {
  border-color: #3c89e8;
}

QLineEdit:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
  border-color: #1668dc;
}

QLineEdit[readOnly="true"] {
  background-color: #1f1f1f;
  border-color: #303030;
  color: #8c8c8c;
}

QLineEdit:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
  background-color: #262626;
  border-color: #303030;
  color: #595959;
}

QLineEdit[validation="error"]   { border: 1px solid #dc4446; }
QLineEdit[validation="warning"] { border: 1px solid #d89614; }
QLineEdit[validation="ok"]      { border: 1px solid #49aa19; }

QTextEdit,
QPlainTextEdit,
QTextBrowser {
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 4px;
  selection-background-color: #111a2c;
}

QTextEdit:hover,
QPlainTextEdit:hover,
QTextBrowser:hover {
  border-color: #3c89e8;
}

QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus {
  border-color: #1668dc;
}

QTextEdit[supervisormsg=true] {
  border: 2px solid #dc4446;
  margin: 2px;
}

/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
  border: 1px solid #303030;
  margin-top: 1.2em;
  padding: 8px 6px 6px 6px;
  border-radius: 8px;
  background-color: #1f1f1f;
}

QGroupBox::disabled {
  background-color: rgba(31, 31, 31, 150);
}

QGroupBox::unchecked {
  border: 0px;
}

QGroupBox::title {
  top: 0px;
  left: 8px;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0px 5px;
  color: #d9d9d9;
  background-color: #1f1f1f;
  font-weight: 600;
}

/* ============================================================
   TOOL BOX
   ============================================================ */

QToolBox::tab {
  background-color: #1f1f1f;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #a6a6a6;
  min-width: 30px;
  padding: 6px 8px;
}

QToolBox::tab:selected {
  color: #69b1ff;
  background-color: #111a2c;
  border-color: #1668dc;
}

QToolBox::tab:!selected {
  background-color: #262626;
}

QToolBox::tab:hover:!selected {
  background-color: #303030;
  color: #d9d9d9;
}

QToolBox > QWidget {
  border: 0px;
}

/* ============================================================
   COMBO BOX
   ============================================================ */

QComboBox {
  combobox-popup: 0;
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 3px 7px;
  min-height: 20px;
  selection-background-color: #111a2c;
}

QComboBox:focus {
  border-color: #1668dc;
}

QComboBox:hover {
  border-color: #3c89e8;
}

QComboBox:disabled {
  background-color: #262626;
  border-color: #303030;
  color: #595959;
}

QComboBox::drop-down {
  border: none;
  width: 24px;
}

QComboBox::down-arrow {
  image: url(:/ant-design/icons/ant-design/down.svg);
  width: 12px;
  height: 12px;
}

QComboBoxPrivateContainer,
QWidget#comboBoxPopup {
  background-color: #1f1f1f;
  border: 1px solid #424242;
  border-radius: 0px;
  margin: 0px;
  padding: 0px;
}

QComboBox QAbstractItemView,
QComboBoxPrivateContainer QAbstractItemView {
  background-color: #1f1f1f;
  border: 0px;
  color: #d9d9d9;
  selection-background-color: #111a2c;
  outline: none;
  padding: 4px;
}

/* ============================================================
   SPIN BOX
   ============================================================ */

QDoubleSpinBox,
QSpinBox {
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 3px 7px;
  min-height: 20px;
}

QDoubleSpinBox:hover,
QSpinBox:hover {
  border-color: #3c89e8;
}

QDoubleSpinBox:focus,
QSpinBox:focus {
  border-color: #1668dc;
}

QDoubleSpinBox:disabled,
QSpinBox:disabled {
  background-color: #262626;
  border-color: #303030;
  color: #595959;
}

/* ============================================================
   MENU BAR / MENU
   ============================================================ */

QMenuBar {
  background-color: #1f1f1f;
  border-bottom: 1px solid #303030;
  padding: 2px 0px 0px 6px;
  margin: 0px;
}

QMenuBar::item {
  spacing: 4px;
  padding: 4px 8px;
  background: transparent;
  border-radius: 6px;
  color: #d9d9d9;
}

QMenuBar::item:selected {
  background-color: #262626;
}

QMenuBar::item:pressed {
  background-color: #111a2c;
}

QMenu {
  background-color: #1f1f1f;
  border: 1px solid #424242;
  color: #d9d9d9;
  font-style: normal;
  font-weight: normal;
  padding: 4px;
}

QMenu::item {
  padding: 6px 24px 6px 12px;
  border-radius: 4px;
}

QMenu::item:selected {
  background-color: #111a2c;
  color: #ffffff;
}

QMenu::separator {
  height: 1px;
  background-color: #424242;
  margin: 3px 10px;
}

QMenu > QFrame {
  color: #d9d9d9;
}

swift--gui--CDockWidgetInfoArea > QMenu > QMenuWidget {
  border: 0px;
}

QScrollArea QMenu {
  background-color: #1f1f1f;
  border: 1px solid #424242;
  color: #d9d9d9;
  padding: 0px;
}

/* ============================================================
   RADIO BUTTON
   ============================================================ */

QRadioButton::indicator:checked,
QRadioButton::indicator:unchecked {
  color: #d9d9d9;
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 7px;
  width: 13px;
  height: 13px;
}

QRadioButton::indicator:hover {
  border-color: #3c89e8;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5,
    fx: 0.5, fy: 0.5,
    radius: 1.0,
    stop: 0.25 #1668dc,
    stop: 0.35 #303030
  );
  border-color: #1668dc;
}

QRadioButton::disabled {
  color: #595959;
  border: 0px;
}

/* ============================================================
   SCROLL AREA
   ============================================================ */

QScrollArea {
  border: 1px solid #303030;
  border-radius: 6px;
}

QScrollArea > * > QWidget {
  background-color: #1f1f1f;
}

/* ============================================================
   SCROLL BAR
   ============================================================ */

QScrollBar:horizontal {
  border: none;
  background-color: #141414;
  height: 8px;
  margin: 0px;
}

QScrollBar:vertical {
  border: none;
  background-color: #141414;
  width: 8px;
  margin: 0px;
}

QScrollBar::handle:horizontal {
  background-color: #595959;
  border-radius: 4px;
  min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
  background-color: #8c8c8c;
}

QScrollBar::handle:vertical {
  background-color: #595959;
  border-radius: 4px;
  min-height: 20px;
}

QScrollBar::handle:vertical:hover {
  background-color: #8c8c8c;
}

QScrollBar::add-line,
QScrollBar::sub-line {
  border: none;
  background: none;
  width: 0px;
  height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: none;
}

/* ============================================================
   HEADER VIEW (tables)
   ============================================================ */

QHeaderView {
  border: none;
  background-color: #141414;
}

QHeaderView::section {
  background-color: #1f1f1f;
  border: none;
  border-right: 1px solid #303030;
  border-bottom: 1px solid #303030;
  color: #a6a6a6;
  padding: 5px 8px;
  font-weight: 600;
}

QHeaderView::section:hover {
  background-color: #262626;
  color: #d9d9d9;
}

QHeaderView::section:first {
  border-left: none;
}

QTableView QTableCornerButton::section {
  background-color: #262626;
  border: 1px solid #424242;
}

QHeaderView::down-arrow {
  image: url(:/ant-design/icons/ant-design/down.svg);
  subcontrol-position: bottom left;
}

QHeaderView::up-arrow {
  image: url(:/ant-design/icons/ant-design/up.svg);
  subcontrol-position: bottom left;
}

/* ============================================================
   TABLE / TREE / LIST VIEW
   ============================================================ */

QTableView, QTreeView, QListView {
  border: 1px solid #424242;
  border-radius: 6px;
  background-color: #141414;
  alternate-background-color: #1f1f1f;
  selection-background-color: #111a2c;
  selection-color: #ffffff;
  gridline-color: #262626;
  margin: 0px;
  padding: 0px;
  outline: none;
}

QTableView::item:selected {
  background-color: #111a2c;
  color: #d9d9d9;
}

QTableView::item:hover {
  background-color: #262626;
}

QListView::item:selected {
  background-color: #111a2c;
  color: #d9d9d9;
}

QListView::item:hover {
  background-color: #262626;
}

QTreeView {
  show-decoration-selected: 1;
}

QTreeView::item {
  border: 0px;
  padding: 4px;
}

QTreeView::item:hover {
  background-color: #262626;
}

QTreeView::item:selected {
  background-color: #111a2c;
  color: #d9d9d9;
}

QTreeView::branch:open:has-children {
  image: url(:/ant-design/icons/ant-design/right.svg);
}

QTreeView::branch:closed:has-children {
  image: url(:/ant-design/icons/ant-design/down.svg);
}

/* ============================================================
   SLIDER
   ============================================================ */

QSlider {
  min-height: 2em;
  background: transparent;
}

QSlider::groove:horizontal {
  border: none;
  height: 3px;
  background-color: #424242;
  border-radius: 1px;
}

QSlider::handle:horizontal {
  background-color: #1668dc;
  border: 1px solid #424242;
  width: 14px;
  height: 14px;
  margin: -6px 0;
  border-radius: 7px;
}

QSlider::handle:horizontal:hover {
  background-color: #3c89e8;
  border-color: #3c89e8;
}

QSlider:disabled {
  color: #595959;
}

QSlider:disabled::groove:horizontal,
QSlider:disabled::handle:horizontal {
  background-color: #303030;
  border-color: #303030;
}

/* ============================================================
   SIZE GRIP
   ============================================================ */

QSizeGrip {
  image: url(:/ant-design/icons/ant-design/resize.svg);
  padding: 0px 20px 0px 0px;
  width: 16px;
  height: 16px;
}

/* ============================================================
   STATUS BAR
   ============================================================ */

QStatusBar {
  background-color: #1f1f1f;
  color: #a6a6a6;
  border-top: 1px solid #303030;
  min-height: 22px;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  border: none;
  color: #a6a6a6;
  padding-left: 5px;
}

#btn_StatusBarWarnsb_MainStatusBar {
  background-color: #2b2111;
  color: #e8b339;
  border: 1px solid #594214;
  border-radius: 4px;
}

#btn_StatusBarErrorsb_MainStatusBar {
  background-color: #2c1618;
  color: #ff7875;
  border: 1px solid #58181c;
  border-radius: 4px;
}

/* ============================================================
   TOOL BAR / DOCK WIDGET / WIZARD
   ============================================================ */

QToolBar {
  background-color: #1f1f1f;
  border: none;
  border-bottom: 1px solid #303030;
  spacing: 4px;
  padding: 4px;
}

QToolBar::separator {
  background-color: #424242;
  width: 1px;
  height: 1px;
  margin: 4px;
}

QDockWidget {
  color: #d9d9d9;
  titlebar-close-icon: url(:/ant-design/icons/ant-design/close.svg);
}

QDockWidget::title {
  background-color: #1f1f1f;
  border-bottom: 1px solid #303030;
  padding: 6px 8px;
  text-align: left;
}

QWizard,
QWizardPage,
QMessageBox {
  background-color: #141414;
}

QWizard QLabel,
QMessageBox QLabel {
  color: #d9d9d9;
}

/* Semantic status surfaces. Set statusRole to info, success, warning or error. */
QLabel[statusRole="info"],
QToolButton[statusRole="info"] {
  background-color: #111a2c;
  border: 1px solid #15325b;
  border-radius: 6px;
  color: #69b1ff;
  padding: 3px 7px;
}

QLabel[statusRole="success"],
QToolButton[statusRole="success"] {
  background-color: #162312;
  border: 1px solid #274916;
  border-radius: 6px;
  color: #95de64;
  padding: 3px 7px;
}

QLabel[statusRole="warning"],
QToolButton[statusRole="warning"] {
  background-color: #2b2111;
  border: 1px solid #594214;
  border-radius: 6px;
  color: #e8b339;
  padding: 3px 7px;
}

QLabel[statusRole="error"],
QToolButton[statusRole="error"] {
  background-color: #2c1618;
  border: 1px solid #58181c;
  border-radius: 6px;
  color: #ff7875;
  padding: 3px 7px;
}

/* ============================================================
   TOOLTIP
   ============================================================ */

QToolTip {
  color: #d9d9d9;
  background-color: #1f1f1f;
  border: 1px solid #424242;
  border-radius: 6px;
  padding: 4px 8px;
}

/* ============================================================
   LEVEL METER
   ============================================================ */

swift--gui--CLevelMeter {
  qproperty-lowColor: #49aa19;
  border: 1px solid #424242;
  border-radius: 3px;
  padding: 1px;
  height: 1em;
}

/* ============================================================
   MARGINS INPUT
   ============================================================ */

swift--gui--Components--CMarginsInput QLineEdit {
  color: #d9d9d9;
}
