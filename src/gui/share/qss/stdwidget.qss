/*
 Modern dark theme inspired by VS Code Dark+
 Color palette:
   bg-base:       #1e1e1e  (main window, dialogs)
   bg-panel:      #252526  (panels, dock areas)
   bg-surface:    #2d2d2d  (group boxes, inner areas)
   bg-input:      #3c3c3c  (input fields, combos)
   border-default:#474747  (default borders)
   accent:        #007acc  (focus, active accent)
   accent-dim:    #0e639c  (buttons)
   accent-hover:  #1177bb  (button hover)
   text-primary:  #cccccc
   text-disabled: #858585
   selection-bg:  #094771
   success:       #4ec994
   warning:       #cca700
   error:         #f14c4c

Used dynamic properties:
  framelessMainWindow (infobar.qss, here)
*/

/* ============================================================
   BASE WIDGET
   ============================================================ */

QFrame {
  border-style: solid;
  border-color: transparent;
  border-width: 1px;
}

QCheckBox {
  border: 0px;
  background: transparent;
  spacing: 5px;
}

QCheckBox::indicator {
  color: #cccccc;
  border: 1px solid #474747;
  background-color: #3c3c3c;
  width: 13px;
  height: 13px;
  border-radius: 3px;
}

QCheckBox::indicator:hover {
  border-color: #007acc;
}

QCheckBox::indicator:checked {
  background-color: #007acc;
  border-color: #007acc;
  image: url(:/diagona/icons/diagona/icons/tick.png);
}

QCheckBox::indicator:indeterminate {
  background-color: #3c3c3c;
  border-color: #474747;
  image: url(:/diagona/icons/diagona/icons/question.png);
}

/* ============================================================
   MAIN WINDOW / DIALOG
   ============================================================ */

QMainWindow {
  background-color: #1e1e1e;
}

QMainWindow::separator {
  background: transparent;
  width: 0px;
  height: 0px;
}

QMainWindow::separator:hover {
  background: transparent;
}

QDialog {
  background-color: #1e1e1e;
}

QDialog::separator {
  background: transparent;
  width: 0px;
  height: 0px;
}

QDialog::separator:hover {
  background: transparent;
}

QFileDialog #sidebar {
  background: #252526;
}

QFileDialog QToolButton {
  background: inherit;
}

QColorDialog {
  background-color: #1e1e1e;
}

/* ============================================================
   DOCK WIDGET / INFO AREA
   ============================================================ */

swift--gui--CDockWidgetInfoArea {
  background-color: #007acc;
}

swift--gui--CDockWidgetInfoArea > QWidget[dockwidget="outerwidget"] {
  background-color: #252526;
}

swift--gui--CDockWidgetInfoArea[framelessDockWidget="true"] > QWidget > QFrame[dockwidget="innerwidget"] {
  margin: 0px;
  padding: 3px;
  border: 1px solid #007acc;
  border-radius: 6px;
}

swift--gui--CDockWidgetInfoArea[framelessDockWidget="false"] > QWidget > QFrame[dockwidget="innerwidget"] {
  /* void */
}

swift--gui--CInfoArea {
  background-color: #252526;
}

swift--gui--COverlayMessages {
  background-color: rgba(30, 30, 30, 220);
  border: 1px solid #474747;
  border-radius: 6px;
}

swift--gui--CDropSite {
  color: #858585;
  border: 1px dashed #474747;
  border-radius: 4px;
  min-height: 18px;
  max-height: 18px;
  margin: 2px;
  padding: 2px;
}

swift--gui--Editors--CValidationIndicator {
  background-color: #252526;
}

swift--gui--CPluginDetailsWindow,
swift--gui--CPluginConfigWindow {
  background-color: #1e1e1e;
}

swift--gui--Components--CDBusServerAddressSelector::disabled {
  background-color: rgba(60, 60, 60, 128);
}

swift--gui--Components--CSimulatorSelector::disabled {
  background-color: rgba(60, 60, 60, 128);
}

swift--gui--Components--CAircraftModelSetValidationDialog,
swift--gui--Components--CCoreSettingsDialog,
swift--gui--Views--CAircraftModelValidationDialog,
swift--gui--Views--CAircraftModelStatisticsDialog,
swift--gui--Components--CSettingsFontDialog,
swift--gui--Components--CAirportDialog,
swift--gui--Components--CTextEditDialog,
swift--gui--Components--CSetupLoadingDialog,
swift--gui--Components--CDownloadComponent,
swift--gui--Components--CDownloadDialog,
swift--gui--Components--CUpdateInfoDialog,
swift--gui--Components--CRawFsdMessagesComponent,
swift--gui--Components--CRawFsdMessagesDialog,
swift--gui--Components--CDbOwnModelsDialog,
swift--gui--Components--CDbOwnModelSetDialog,
swift--gui--Components--CFirstModelSetComponent,
swift--gui--Components--CDbAircraftIcaoComponent,
swift--gui--Components--CDbLiveryComponent,
swift--gui--Components--CDbDistributorComponent,
swift--gui--Components--CLegalInfoComponent,
swift--gui--Components--CStringListDialog
{
  background-color: #252526;
}

swift--gui--Components--CCockpitComComponent {
  min-height: 7em;
}

/* ============================================================
   BUTTONS
   ============================================================ */

QToolButton {
  background-color: #2d2d2d;
  border: 1px solid #474747;
  border-radius: 3px;
  padding: 2px 4px;
  color: #cccccc;
}

QToolButton:hover {
  background-color: #3c3c3c;
  border-color: #007acc;
}

QToolButton:pressed {
  background-color: #094771;
}

#tb_AtcStationsAtisReload,
#tb_AtcStationsLoadMetar,
#tb_Audio,
#tb_TextMessageOverlay,
QPushButton {
  background-color: #0e639c;
  border: 1px solid #0e639c;
  border-radius: 3px;
  color: #ffffff;
  padding: 2px 8px;
  margin-right: 4px;
  min-width: 25px;
  min-height: 20px;
}

QPushButton:hover {
  background-color: #1177bb;
  border-color: #1177bb;
}

QPushButton:pressed {
  background-color: #094771;
  border-color: #094771;
}

QPushButton:checked {
  background-color: #094771;
  border-color: #007acc;
}

QPushButton:focus {
  border-color: #007acc;
  outline: none;
}

QPushButton::disabled {
  background-color: #2d2d2d;
  border: 1px solid #3a3a3a;
  border-radius: 3px;
  color: #858585;
  padding: 2px 8px;
  margin-right: 4px;
  qproperty-textElideMode: ElideMiddle;
}

QPushButton[blinkOn="true"] {
  background-color: #cca700;
  border-color: #cca700;
  color: #1e1e1e;
}

/* ============================================================
   PROGRESS BAR
   ============================================================ */

QProgressBar {
  border: 1px solid #474747;
  border-radius: 4px;
  background-color: #3c3c3c;
  text-align: center;
  color: #cccccc;
  padding: 0px;
  height: 14px;
}

QProgressBar::chunk {
  background-color: #0e639c;
  border-radius: 3px;
  margin: 1px;
}

/* ============================================================
   TABS
   ============================================================ */

QTabWidget::pane {
  border: 1px solid #474747;
  border-top: none;
  background-color: #252526;
}

QTabWidget::tab-bar {
  left: 0px;
}

QTabBar::tab {
  background-color: #2d2d2d;
  border: 1px solid #474747;
  border-bottom: none;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  color: #858585;
  min-width: 30px;
  padding: 4px 8px;
  margin-right: 1px;
}

QTabBar::tab:selected {
  background-color: #1e1e1e;
  color: #cccccc;
  border-bottom: 2px solid #007acc;
}

QTabBar::tab:hover:!selected {
  background-color: #3c3c3c;
  color: #cccccc;
}

QTabBar::tear {
  image: url(:/own/icons/own/transparent1px.png);
  max-width: 1px;
}

QTabBar QToolButton {
  background-color: #2d2d2d;
  border: 1px solid #474747;
  color: #cccccc;
}

QTabBar QToolButton:hover {
  background-color: #3c3c3c;
}

/* supervisor message tab highlight */
QTabBar::tab[supervisormsg=true] {
  background-color: #5a1d1d;
  border-color: #f14c4c;
  color: #f14c4c;
}

QTabBar QToolButton[supervisormsg=true] {
  background-color: #5a1d1d;
}

/* ============================================================
   SPLITTER
   ============================================================ */

QSplitter {
  margin: 0px;
  border: 0px;
  padding: 0px;
}

QSplitter::handle {
  background-color: #3c3c3c;
  margin: 0px;
}

QSplitter::handle:horizontal {
  width: 3px;
}

QSplitter::handle:vertical {
  height: 3px;
}

QSplitter::handle:hover {
  background-color: #007acc;
}

QSplitter::handle:pressed {
  background-color: #007acc;
}

/* ============================================================
   LABEL
   ============================================================ */

QLabel {
  background: transparent;
}

/* ============================================================
   LINE EDIT / TEXT EDIT
   ============================================================ */

QLineEdit {
  background-color: #3c3c3c;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  padding: 2px 4px;
  selection-background-color: #094771;
}

QLineEdit:focus {
  border-color: #007acc;
}

QLineEdit[readOnly="true"] {
  background-color: #2d2d2d;
  border: 1px solid #3a3a3a;
  color: #858585;
}

QLineEdit:disabled {
  background-color: #2d2d2d;
  border: 1px solid #3a3a3a;
  color: #858585;
}

QLineEdit[validation="error"]   { border: 1px solid #f14c4c; }
QLineEdit[validation="warning"] { border: 1px solid #cca700; }
QLineEdit[validation="ok"]      { border: 1px solid #4ec994; }

QTextEdit {
  background-color: #1e1e1e;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  selection-background-color: #094771;
}

QTextEdit:focus {
  border-color: #007acc;
}

QTextEdit[supervisormsg=true] {
  border: 2px solid #f14c4c;
  margin: 2px;
}

QPlainTextEdit {
  background-color: #1e1e1e;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  selection-background-color: #094771;
}

QPlainTextEdit:focus {
  border-color: #007acc;
}

/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
  border: 1px solid #474747;
  margin-top: 1.2em;
  padding-top: 0.5em;
  border-radius: 4px;
  background-color: #252526;
}

QGroupBox::disabled {
  background-color: rgba(37, 37, 38, 150);
}

QGroupBox::unchecked {
  border: 0px;
}

QGroupBox::title {
  top: 0px;
  left: 10px;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0px 6px;
  color: #858585;
  background-color: #252526;
}

/* ============================================================
   TOOL BOX
   ============================================================ */

QToolBox::tab {
  background-color: #2d2d2d;
  border: 1px solid #474747;
  border-radius: 4px;
  color: #858585;
  min-width: 30px;
  padding: 4px 6px;
}

QToolBox::tab:selected {
  color: #cccccc;
  background-color: #094771;
  border-color: #007acc;
}

QToolBox::tab:!selected {
  background-color: #2d2d2d;
}

QToolBox::tab:hover:!selected {
  background-color: #3c3c3c;
  color: #cccccc;
}

QToolBox > QWidget {
  border: 0px;
}

/* ============================================================
   COMBO BOX
   ============================================================ */

QComboBox {
  background-color: #3c3c3c;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  padding: 2px 4px;
  selection-background-color: #094771;
}

QComboBox:focus {
  border-color: #007acc;
}

QComboBox:hover {
  border-color: #007acc;
}

QComboBox:disabled {
  background-color: #2d2d2d;
  border: 1px solid #3a3a3a;
  color: #858585;
}

QComboBox::drop-down {
  border: none;
  width: 20px;
}

QComboBox QAbstractItemView {
  background-color: #2d2d2d;
  border: 1px solid #474747;
  color: #cccccc;
  selection-background-color: #094771;
  outline: none;
}

/* ============================================================
   SPIN BOX
   ============================================================ */

QDoubleSpinBox {
  background-color: #3c3c3c;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  padding: 2px 4px;
}

QDoubleSpinBox:focus {
  border-color: #007acc;
}

QSpinBox {
  background-color: #3c3c3c;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  padding: 2px 4px;
}

QSpinBox:focus {
  border-color: #007acc;
}

/* ============================================================
   MENU BAR / MENU
   ============================================================ */

QMenuBar {
  background-color: #2d2d2d;
  border-bottom: 1px solid #474747;
  padding: 2px 0px 0px 6px;
  margin: 0px;
}

QMenuBar::item {
  spacing: 4px;
  padding: 4px 8px;
  background: transparent;
  border-radius: 3px;
  color: #cccccc;
}

QMenuBar::item:selected {
  background-color: #3c3c3c;
}

QMenuBar::item:pressed {
  background-color: #094771;
}

QMenu {
  background-color: #252526;
  border: 1px solid #474747;
  color: #cccccc;
  font-style: normal;
  font-weight: normal;
  padding: 4px 0px;
}

QMenu::item {
  padding: 5px 20px 5px 20px;
}

QMenu::item:selected {
  background-color: #094771;
  color: #ffffff;
}

QMenu::separator {
  height: 1px;
  background-color: #474747;
  margin: 3px 10px;
}

QMenu > QFrame {
  color: #cccccc;
}

swift--gui--CDockWidgetInfoArea > QMenu > QMenuWidget {
  border: 0px;
}

QScrollArea QMenu {
  background-color: #252526;
  border: 1px solid #474747;
  color: #cccccc;
  padding: 0px;
}

/* ============================================================
   RADIO BUTTON
   ============================================================ */

QRadioButton::indicator:checked,
QRadioButton::indicator:unchecked {
  color: #cccccc;
  background-color: #3c3c3c;
  border: 1px solid #474747;
  border-radius: 7px;
  width: 13px;
  height: 13px;
}

QRadioButton::indicator:hover {
  border-color: #007acc;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5,
    fx: 0.5, fy: 0.5,
    radius: 1.0,
    stop: 0.25 #007acc,
    stop: 0.35 #3c3c3c
  );
  border-color: #007acc;
}

QRadioButton::disabled {
  color: #858585;
  border: 0px;
}

/* ============================================================
   SCROLL AREA
   ============================================================ */

QScrollArea {
  border: 1px solid #474747;
  border-radius: 3px;
}

QScrollArea > * > QWidget {
  background-color: #252526;
}

/* ============================================================
   SCROLL BAR
   ============================================================ */

QScrollBar:horizontal {
  border: none;
  background-color: #1e1e1e;
  height: 8px;
  margin: 0px;
}

QScrollBar:vertical {
  border: none;
  background-color: #1e1e1e;
  width: 8px;
  margin: 0px;
}

QScrollBar::handle:horizontal {
  background-color: #474747;
  border-radius: 4px;
  min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
  background-color: #6d6d6d;
}

QScrollBar::handle:vertical {
  background-color: #474747;
  border-radius: 4px;
  min-height: 20px;
}

QScrollBar::handle:vertical:hover {
  background-color: #6d6d6d;
}

QScrollBar::add-line,
QScrollBar::sub-line {
  border: none;
  background: none;
  width: 0px;
  height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: none;
}

/* ============================================================
   HEADER VIEW (tables)
   ============================================================ */

QHeaderView {
  border: none;
  background-color: #252526;
}

QHeaderView::section {
  background-color: #2d2d2d;
  border: none;
  border-right: 1px solid #474747;
  border-bottom: 1px solid #474747;
  color: #858585;
  padding: 3px 6px;
  font-weight: normal;
}

QHeaderView::section:hover {
  background-color: #3c3c3c;
  color: #cccccc;
}

QHeaderView::section:first {
  border-left: none;
}

QTableView QTableCornerButton::section {
  background-color: #2d2d2d;
  border: 1px solid #474747;
}

QHeaderView::down-arrow {
  image: url(:/diagona/icons/diagona/icons/arrow-270-small.png);
  subcontrol-position: bottom left;
}

QHeaderView::up-arrow {
  image: url(:/diagona/icons/diagona/icons/arrow-090-small.png);
  subcontrol-position: bottom left;
}

/* ============================================================
   TABLE / TREE / LIST VIEW
   ============================================================ */

QTableView, QTreeView, QListView {
  border: 1px solid #474747;
  border-radius: 3px;
  background-color: #1e1e1e;
  alternate-background-color: #252526;
  selection-background-color: #094771;
  selection-color: #ffffff;
  gridline-color: #2d2d2d;
  margin: 1px;
  padding: 0px;
  outline: none;
}

QTableView::item:selected {
  background-color: #094771;
  color: #ffffff;
}

QTableView::item:hover {
  background-color: #2a2d2e;
}

QListView::item:selected {
  background-color: #094771;
  color: #ffffff;
}

QListView::item:hover {
  background-color: #2a2d2e;
}

QTreeView {
  show-decoration-selected: 1;
}

QTreeView::item {
  border: 0px;
  padding: 2px;
}

QTreeView::item:hover {
  background-color: #2a2d2e;
}

QTreeView::item:selected {
  background-color: #094771;
  color: #ffffff;
}

QTreeView::branch:open:has-children {
  image: url(:/diagona/icons/diagona/icons/toggle.png);
}

QTreeView::branch:closed:has-children {
  image: url(:/diagona/icons/diagona/icons/toggle-expand.png);
}

/* ============================================================
   SLIDER
   ============================================================ */

QSlider {
  min-height: 2em;
}

QSlider::groove:horizontal {
  border: none;
  height: 3px;
  background-color: #474747;
  border-radius: 1px;
}

QSlider::handle:horizontal {
  background-color: #cccccc;
  border: 1px solid #474747;
  width: 14px;
  height: 14px;
  margin: -6px 0;
  border-radius: 7px;
}

QSlider::handle:horizontal:hover {
  background-color: #007acc;
  border-color: #007acc;
}

/* ============================================================
   SIZE GRIP
   ============================================================ */

QSizeGrip {
  image: url(:/diagona/icons/diagona/icons/arrow-in-out.png);
  padding: 0px 20px 0px 0px;
  width: 16px;
  height: 16px;
}

/* ============================================================
   STATUS BAR
   ============================================================ */

QStatusBar {
  background-color: #007acc;
  color: #ffffff;
  min-height: 20px;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  border: none;
  color: #ffffff;
  padding-left: 5px;
}

#btn_StatusBarWarnsb_MainStatusBar {
  background-color: #cca700;
  color: #1e1e1e;
  border: none;
  border-radius: 0px;
}

#btn_StatusBarErrorsb_MainStatusBar {
  background-color: #f14c4c;
  color: #ffffff;
  border: none;
  border-radius: 0px;
}

/* ============================================================
   TOOLTIP
   ============================================================ */

QToolTip {
  color: #cccccc;
  background-color: #252526;
  border: 1px solid #474747;
  padding: 3px 6px;
}

/* ============================================================
   LEVEL METER
   ============================================================ */

swift--gui--CLevelMeter {
  qproperty-lowColor: #4ec994;
  border: 1px solid #474747;
  border-radius: 3px;
  padding: 1px;
  height: 1em;
}

/* ============================================================
   MARGINS INPUT
   ============================================================ */

swift--gui--Components--CMarginsInput QLineEdit {
  color: #cccccc;
}
