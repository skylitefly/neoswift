/*
 Modern dark theme - swift GUI specific
 VS Code Dark+ inspired color palette
*/

/* ============================================================
   FRAMELESS MAIN WINDOW
   ============================================================ */

#wi_CentralWidgetOutside[framelessMainWindow="true"] {
  background-color: #1e1e1e;
  margin: 0px;
  border: 1px solid #474747;
  border-radius: 8px;
}

/* ============================================================
   CENTRAL FRAME
   ============================================================ */

#fr_CentralFrameInside {
  margin-right: 4px;
  margin-left: 4px;
  margin-top: 2px;
  margin-bottom: 4px;
}

#gb_AtcStationsOnlineInfo {
  border-style: none;
}

#sw_MainMiddle {
  padding: 3px;
  border: 1px solid #474747;
  border-radius: 6px;
  background-color: #252526;
}

/* ============================================================
   FRAMELESS CLOSE BUTTON
   ============================================================ */

#pb_FramelessCloseButton {
  background: transparent;
  padding: 4px;
  margin: 0px;
  border: 0px;
  color: #858585;
  min-width: 16px;
  min-height: 16px;
}

#pb_FramelessCloseButton:hover {
  background-color: #f14c4c;
  color: #ffffff;
  border-radius: 3px;
}

/* ============================================================
   SETTINGS
   ============================================================ */

#comp_Settings QToolButton {
  background-color: #0e639c;
  border: 1px solid #0e639c;
  border-radius: 3px;
  color: #ffffff;
  padding: 2px 6px;
}

#comp_Settings QToolButton:hover {
  background-color: #1177bb;
}

/* ============================================================
   KEYPAD AREA
   ============================================================ */

#wi_MainKeypadArea QPushButton {
  background-color: #2d2d2d;
  color: #cccccc;
  border: 1px solid #474747;
  border-radius: 4px;
  max-height: 22px;
  min-width: 60px;
  min-height: 22px;
}

#wi_MainKeypadArea QPushButton:hover {
  background-color: #3c3c3c;
  border-color: #007acc;
}

#wi_MainKeypadArea QPushButton:checked {
  border: 1px solid #007acc;
  background-color: #0e639c;
  color: #ffffff;
  font: bold;
}

#wi_MainKeypadArea QPushButton#pb_Connect:checked {
  background-color: #1a7340;
  border-color: #4ec994;
  color: #ffffff;
}

#wi_MainKeypadArea QPushButton:pressed {
  background-color: #094771;
}

/* ============================================================
   COCKPIT COM
   ============================================================ */

#comp_CockpitComComponent QPushButton {
  background-color: transparent;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  padding: 1px 4px;
  margin: 1px;
}

#comp_CockpitComComponent QPushButton:hover {
  background-color: #3c3c3c;
  border-color: #007acc;
}

#comp_CockpitComComponent QPushButton:checked {
  background-color: #094771;
  border-color: #007acc;
  color: #ffffff;
}

/* ============================================================
   COM PANEL
   ============================================================ */

#wip_CockpitComPanelShowHideBar QPushButton {
  background-color: transparent;
  border: 1px solid #474747;
  border-radius: 3px;
  color: #cccccc;
  padding: 1px 4px;
}

#wip_CockpitComPanelShowHideBar QPushButton:hover {
  background-color: #3c3c3c;
  border-color: #007acc;
}

/* ============================================================
   AUDIO SETUP
   ============================================================ */

#sa_AudioSetup {
  background-color: #252526;
}

#sa_AudioComponentInner {
  background-color: #252526;
}

/* ============================================================
   COMMAND LINE INPUT
   ============================================================ */

#lep_CommandLineInput {
  background-color: #1e1e1e;
  border: 1px solid #474747;
  border-radius: 4px;
  margin-bottom: 4px;
  padding: 3px;
}

#lep_CommandLineInput:focus {
  border-color: #007acc;
}

/* ============================================================
   HOTKEY
   ============================================================ */

#gb_hotkey #gb_action #gb_machine {
  background-color: #252526;
}
