/*
 Ant Design 5 dark theme - swift GUI specific
*/

/* ============================================================
   FRAMELESS MAIN WINDOW
   ============================================================ */

#wi_CentralWidgetOutside[framelessMainWindow="true"] {
  background-color: #141414;
  margin: 0px;
  border: 1px solid #424242;
  border-radius: 8px;
}

/* ============================================================
   CENTRAL FRAME
   ============================================================ */

#fr_CentralFrameInside {
  margin-right: 4px;
  margin-left: 4px;
  margin-top: 2px;
  margin-bottom: 4px;
}

#gb_AtcStationsOnlineInfo {
  border-style: none;
}

#sw_MainMiddle {
  padding: 4px;
  border: 1px solid #303030;
  border-radius: 8px;
  background-color: #1f1f1f;
}

/* ============================================================
   FRAMELESS CLOSE BUTTON
   ============================================================ */

#pb_FramelessCloseButton {
  background: transparent;
  padding: 4px;
  margin: 0px;
  border: 0px;
  color: #8c8c8c;
  min-width: 16px;
  min-height: 16px;
}

#pb_FramelessCloseButton:hover {
  background-color: #2c1618;
  color: #ff7875;
  border-radius: 6px;
}

/* ============================================================
   SETTINGS
   ============================================================ */

#comp_Settings QToolButton {
  background-color: transparent;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 3px 7px;
}

#comp_Settings QToolButton:hover {
  background-color: #262626;
  border-color: #3c89e8;
  color: #69b1ff;
}

/* ============================================================
   KEYPAD AREA
   ============================================================ */

#wi_MainKeypadArea QPushButton {
  background-color: transparent;
  color: #d9d9d9;
  border: 1px solid #424242;
  border-radius: 6px;
  max-height: 22px;
  min-width: 60px;
  min-height: 22px;
}

#wi_MainKeypadArea QPushButton:hover {
  background-color: #262626;
  border-color: #3c89e8;
  color: #69b1ff;
}

#wi_MainKeypadArea QPushButton:checked {
  border: 1px solid #1668dc;
  background-color: #111a2c;
  color: #69b1ff;
  font: bold;
}

#wi_MainKeypadArea QPushButton#pb_Connect {
  background-color: #1668dc;
  border-color: #1668dc;
  color: #ffffff;
}

#wi_MainKeypadArea QPushButton#pb_Connect:hover {
  background-color: #3c89e8;
  border-color: #3c89e8;
}

#wi_MainKeypadArea QPushButton#pb_Connect:checked {
  background-color: #162312;
  border-color: #274916;
  color: #95de64;
}

#wi_MainKeypadArea QPushButton:pressed {
  background-color: #111a2c;
}

/* ============================================================
   COCKPIT COM
   ============================================================ */

#comp_CockpitComComponent QPushButton {
  background-color: transparent;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 1px 4px;
  margin: 1px;
}

#comp_CockpitComComponent QPushButton:hover {
  background-color: #262626;
  border-color: #3c89e8;
}

#comp_CockpitComComponent QPushButton:checked {
  background-color: #111a2c;
  border-color: #1668dc;
  color: #69b1ff;
}

/* ============================================================
   COM PANEL
   ============================================================ */

#wip_CockpitComPanelShowHideBar QPushButton {
  background-color: transparent;
  border: 1px solid #424242;
  border-radius: 6px;
  color: #d9d9d9;
  padding: 1px 4px;
}

#wip_CockpitComPanelShowHideBar QPushButton:hover {
  background-color: #262626;
  border-color: #3c89e8;
}

/* ============================================================
   AUDIO SETUP
   ============================================================ */

#sa_AudioSetup {
  background-color: #1f1f1f;
}

#sa_AudioComponentInner {
  background-color: #1f1f1f;
}

/* ============================================================
   COMMAND LINE INPUT
   ============================================================ */

#lep_CommandLineInput {
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 6px;
  margin-bottom: 4px;
  padding: 3px;
}

#lep_CommandLineInput:focus {
  border-color: #1668dc;
}

/* ============================================================
   HOTKEY
   ============================================================ */

#gb_hotkey #gb_action #gb_machine {
  background-color: #1f1f1f;
}

#wi_TmSupervisor[statusRole="error"] {
  background-color: #2c1618;
  border: 1px solid #58181c;
  border-radius: 6px;
}
