#lep_CommandLineInput {
  background-color: #141414;
  border: 1px solid #424242;
  border-radius: 4px;
  margin-bottom: 4px;
  padding: 3px;
}

#lep_CommandLineInput:focus {
  border-color: #1668dc;
}

#comp_Log {
  background: transparent;
}

#gb_DBusMode {
  background-color: #1f1f1f;
}

#gb_Controls {
  background-color: #1f1f1f;
}
