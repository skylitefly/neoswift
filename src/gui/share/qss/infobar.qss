/*
 Info bar stylesheet - applied to CDockWidgetInfoBar
 Transponder mode colors:
   I (Ident):   amber  #d97706 bg, dark text
   C (Charlie): green  #1a7340 bg, white text
   S (Standby): blue   #094771 bg, white text
*/

swift--gui--CDockWidgetInfoBar {
  background-color: #252526;
  min-height: 1.25em;
}

swift--gui--CDockWidgetInfoBar[floating="true"] {
  min-width: 50em;
}

swift--gui--Components--CTransponderModeComponent {
  padding: 0px;
  margin:  0px;
}

/* Transponder mode buttons - functional status colors */
QToolButton[xpdrmodeshort="I"] {
  background-color: #d97706;
  border: 1px solid #f59e0b;
  color: #1e1e1e;
  font-weight: bold;
}

QToolButton[xpdrmodeshort="C"] {
  background-color: #1a7340;
  border: 1px solid #4ec994;
  color: #ffffff;
  font-weight: bold;
}

QToolButton[xpdrmodeshort="S"] {
  background-color: #094771;
  border: 1px solid #007acc;
  color: #ffffff;
  font-weight: bold;
}

swift--gui--Components--CInfoBarStatusComponent {
  padding-left:  0.75em;
  padding-right: 0.75em;
}

QLabel {
  margin: 0px;
  padding-left:  0.4em;
  padding-right: 0.2em;
  padding-bottom: 0px;
  padding-top:    0px;
  border: 0px;
}
