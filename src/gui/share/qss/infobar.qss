/*
 Info bar stylesheet - applied to CDockWidgetInfoBar
 Transponder mode colors use Ant Design dark semantic surfaces.
*/

swift--gui--CDockWidgetInfoBar {
  background-color: #1f1f1f;
  min-height: 1.25em;
}

swift--gui--CDockWidgetInfoBar[floating="true"] {
  min-width: 50em;
}

swift--gui--Components--CTransponderModeComponent {
  padding: 0px;
  margin:  0px;
}

/* Transponder mode buttons - functional status colors */
QToolButton[xpdrmodeshort="I"] {
  background-color: #2b2111;
  border: 1px solid #594214;
  color: #e8b339;
  font-weight: bold;
}

QToolButton[xpdrmodeshort="C"] {
  background-color: #162312;
  border: 1px solid #274916;
  color: #95de64;
  font-weight: bold;
}

QToolButton[xpdrmodeshort="S"] {
  background-color: #111a2c;
  border: 1px solid #15325b;
  color: #69b1ff;
  font-weight: bold;
}

swift--gui--Components--CInfoBarStatusComponent {
  padding-left:  0.75em;
  padding-right: 0.75em;
}

QLabel {
  margin: 0px;
  padding-left:  0.4em;
  padding-right: 0.2em;
  padding-bottom: 0px;
  padding-top:    0px;
  border: 0px;
}
