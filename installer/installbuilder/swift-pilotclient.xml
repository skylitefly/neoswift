                    <excludeFiles>*/*.dSYM</excludeFiles>
                    <origin>../../dist/lib/libplugincommon*.dylib</origin>
                </distributionFile>
            </distributionFileList>
        </folder>
        <folder destination="${installdir}/share/icons" name="icons">
            <description>icons</description>
            <platforms>windows</platforms>
            <distributionFileList>
                <distributionFile>
                    <origin>../images/swiftinstaller.ico</origin>
                </distributionFile>
            </distributionFileList>
        </folder>
    </folderList>
    <desktopShortcutList>
        <shortcut>
            <comment>${msg(shortcut.gui.comment)}</comment>
            <name>${msg(shortcut.gui.name)}</name>
            <exec>${installdir}/bin/swiftguistd</exec>
            <path>${installdir}/bin</path>
            <platforms>linux linux-x64 windows</platforms>
            <runAsAdmin>0</runAsAdmin>
            <runInTerminal>0</runInTerminal>
            <windowsExec>${installdir}/bin/swiftguistd.exe</windowsExec>
            <windowsExecArgs></windowsExecArgs>
            <windowsIcon>${installdir}/share/icons/swiftinstaller.ico</windowsIcon>
            <windowsPath>${installdir}/bin</windowsPath>
            <ruleList>
                <isTrue value="${createdesktopshortcut}"/>
            </ruleList>
        </shortcut>
    </desktopShortcutList>
    <startMenuShortcutList>
        <startMenuShortcut>
            <comment>${msg(shortcut.gui.comment)}</comment>
            <name>${msg(shortcut.gui.name)}</name>
            <runAsAdmin>0</runAsAdmin>
            <runInTerminal>0</runInTerminal>
