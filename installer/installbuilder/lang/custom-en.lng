# NeoSwift installer custom strings (English)

installer.waiting.title=Waiting for neoswift to be closed
installer.waiting.progress=It seems that some neoswift application is still in use.\nIt must be closed before the installation can proceed
installer.post.wizard=Run neoswift launcher wizard

install.title=Installation
install.createdesktopshortcut=Create desktop shortcut for neoswift GUI
install.advanced.title=Advanced options
install.advanced.description=Enable advanced options
install.skipwizard=Don't run configuration wizard (neoswift must be configured manually!)

component.neoswift.description=neoswift ${versionFull}
component.neoswift.detailed=neoswift ${versionFull}

component.suite.description=neoswift Software Suite
component.suite.detailed=neoswift software suite.\nThis installs the binaries to run all swift applications.

component.simulators.description=Simulator Plugins

component.fs2004.description=FS9: Flight Sim 2004
component.fs2004.detailed=MS Flight Simulator 2004 Simulator Plugin

component.fsx.description=FSX: Flight Sim X
component.fsx.detailed=MS Flight Simulator X Simulator Plugin\nThis plugin acts as the interface between swift and FSX.

component.msfs.description=MSFS: Flight Sim 2020
component.msfs.detailed=MS Flight Simulator 2020 Simulator Plugin\nThis plugin acts as the interface between swift and MSFS.

component.msfs2024.description=MSFS2024: Flight Sim 2024
component.msfs2024.detailed=MS Flight Simulator 2024 Simulator Plugin\nThis plugin acts as the interface between swift and MSFS2024.

component.p3d.description=PREPAR3D
component.p3d.detailed=LM Prepar3D Simulator Plugin\nThis plugin acts as the interface between swift and P3D.

component.xplane.description=X-Plane
component.xplane.detailed=X-Plane Simulator Plugin\nThis plugin acts as the interface between swift and X-Plane

component.flightgear.description=FlightGear
component.flightgear.detailed=FlightGear Simulator Plugin\nThis plugin acts as the interface between swift and FlightGear

component.emulated.description=Emulated Simulator
component.emulated.detailed=Emulated Simulator Plugin\nThis plugin emulates a running simulator. Use this for testing swift only

component.qt6.description=Qt6 binaries
component.qt6.detailed=Qt6 runtime binaries

component.externals.description=Externals

