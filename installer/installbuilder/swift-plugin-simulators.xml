            <description>FS9: Flight Sim 2004</description>
            <canBeEdited>1</canBeEdited>
            <detailedDescription>MS Flight Simulator 2004 Simulator Plugin</detailedDescription>
            <selected>1</selected>
            <show>1</show>
            <folderList>
                <folder destination="${installdir}/bin/plugins/simulator" name="bin_plugins_simulator">
                    <description>bin/plugins/simulator</description>
                    <platforms>windows</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>../../dist/bin/plugins/simulator/simulatorfs9.dll</origin>
                        </distributionFile>
                    </distributionFileList>
                </folder>
            </folderList>
            <shouldPackRuleList>
                <platformTest>
                    <type>windows</type>
                </platformTest>
                <compareText>
                    <logic>equals</logic>
                    <text>${architecture}</text>
                    <value>32</value>
                </compareText>
            </shouldPackRuleList>
        </component>
